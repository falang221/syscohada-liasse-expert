# Copiez ce fichier vers .env et renseignez les valeurs.
# .env est ignoré par git : n'y mettez jamais de valeur réelle ici.

# --- Base de données ---
# PostgreSQL utilisé par Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syscohada_db

# --- Mistral AI (note de synthèse de la direction) ---
# Requis pour générer le commentaire financier. Sans clé, la section est
# simplement omise de la liasse.
MISTRAL_API_KEY=

# Optionnel. Modèle utilisé pour le commentaire.
# Défaut : mistral-large-latest. Tous les comptes n'y ont pas accès — un
# modèle inaccessible renvoie 429 sur chaque appel. Alternative vérifiée :
# ministral-14b-latest
MISTRAL_MODEL=
