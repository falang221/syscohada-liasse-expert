datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-py"
}

model Cabinet {
  id        String    @id @default(cuid())
  name      String
  users     User[]
  clients   Client[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Client {
  id              String    @id @default(cuid())
  name            String
  ninea           String    @unique
  rccm            String?
  adresse         String?
  capitalSocial   Float?
  cabinetId       String
  cabinet         Cabinet   @relation(fields: [cabinetId], references: [id])
  dossiers        Dossier[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([cabinetId])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  hashed_password String
  role            String    @default("COLLABORATOR") // ADMIN, COLLABORATOR
  cabinetId       String
  cabinet         Cabinet   @relation(fields: [cabinetId], references: [id])
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([cabinetId])
}

model Dossier {
  id              String    @id @default(cuid())
  year            Int
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  tafireData      String?   // JSON string for adjustments (SQLite doesn't support Json well)
  pdfUrl          String?
  isPaid          Boolean   @default(false)
  mappings        AccountMapping[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([clientId])
}

model AccountMapping {
  id        String    @id @default(cuid())
  account   String   // Root account (e.g., "601")
  rubrique  String   // SYSCOHADA Rubrique code
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dossierId])
}

model AuditLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  userId      String?
  action      String
  entity      String
  entityId    String?
  oldValue    String?  // SQLite doesn't support Json as effectively, using String for demo
  newValue    String?
  ipAddress   String?

  @@index([userId])
  @@index([entity, entityId])
}

model Payment {
  id            String    @id @default(cuid())
  amount        Float
  currency      String    @default("XOF")
  status        String    @default("PENDING") // PENDING, SUCCESS, FAILED
  transactionId String?   @unique
  dossierId     String
  dossier       Dossier   @relation(fields: [dossierId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([dossierId])
  @@index([userId])
}
